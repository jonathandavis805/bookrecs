{
  "name": "bookrecs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "dev:web": "cd web && bun run dev",
    "build": "cd web && bun run build",
    "start": "wrangler pages dev",
    "migrate:local": "wrangler d1 migrations apply bookrecs-db --local",
    "mcp": "bun run src/mcp.ts",
    "deploy": "npx wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250116.0",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "otpauth": "^9.6.0"
  }
}
