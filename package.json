{
  "name": "bookrecs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "dev:web": "cd web && bun run dev",
    "dev:cf": "wrangler pages dev",
    "build": "cd web && bun run build",
    "start": "bun run src/server.ts",
    "mcp": "bun run src/mcp.ts",
    "reset-db": "rm -f data/bookrecs.sqlite data/bookrecs.sqlite-shm data/bookrecs.sqlite-wal",
    "demo:swipe": "npx tsx src/demo-swipe.ts",
    "db:create": "wrangler d1 create bookrecs-db",
    "db:migrate": "wrangler d1 execute bookrecs-db --file=migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute bookrecs-db --local --file=migrations/0001_init.sql",
    "deploy": "wrangler pages deploy web/dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250116.0",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "otpauth": "^9.6.0"
  }
}
