{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-declaration-strict-value", "stylelint-value-no-unknown-custom-properties"],
  "rules": {
    "declaration-no-important": true,
    "selector-max-id": 0,
    "csstools/value-no-unknown-custom-properties": true,
    "scale-unlimited/declaration-strict-value": [
      ["/color$/", "box-shadow", "border-radius", "font-size", "fill", "stroke"],
      {
        "ignoreValues": ["transparent", "currentcolor", "inherit", "none", "0", "50%", "unset"],
        "expandShorthand": true,
        "message": "Use a design token from :root in web/src/index.css for \"${property}\" (got \"${value}\")."
      }
    ],
    "no-descending-specificity": null,
    "custom-property-empty-line-before": null
  }
}
